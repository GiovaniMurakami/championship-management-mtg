{
  "name": "championship-management-mtg",
  "version": "1.1.28",
  "description": "API Lambda para gerenciamento de campeonatos de Magic: The Gathering",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/iniciarServidor.ts",
    "lint": "eslint .",
    "build": "node esbuild.config.js",
    "db:migrate-dynamodb": "ts-node src/infra/dynamodb/migrarMongoParaDynamo.ts",
    "db:migrate-dynamodb:dry-run": "npm run db:migrate-dynamodb -- --dry-run",
    "db:migrate-dynamodb:reset": "npm run db:migrate-dynamodb -- --truncate",
    "deploy": "npm run deploy:prod",
    "deploy:dev": "npm run build && serverless deploy --stage dev --region us-east-1",
    "deploy:prod": "npm run build && serverless deploy --stage prod --region us-east-1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --verbose --runInBand --testPathIgnorePatterns=tests/e2e",
    "test:e2e": "npm run test:e2e:cache && npm run test:e2e:dynamodb && npm run test:e2e:torneio-cache && npm run test:e2e:torneio150",
    "test:e2e:cache": "node -r dotenv/config -e \"process.env.RUN_DYNAMODB_CACHE_E2E='true'; process.env.E2E_ALLOW_NONLOCAL_CACHE='true'; require('jest').run(['--runInBand','tests/e2e/cacheDynamoDb.e2e.test.ts'])\"",
    "test:e2e:torneio-cache": "node -r dotenv/config -e \"process.env.RUN_TORNEIO_CACHE_E2E='true'; process.env.E2E_ALLOW_NONLOCAL_CACHE='true'; require('jest').run(['--runInBand','tests/e2e/fluxoTorneioCache.e2e.test.ts'])\"",
    "test:e2e:torneio150": "node -r dotenv/config -e \"process.env.RUN_TORNEIO_150_E2E='true'; require('jest').run(['--runInBand','tests/e2e/fluxoTorneio150.e2e.test.ts'])\"",
    "test:e2e:dynamodb": "node -r dotenv/config -e \"process.env.RUN_DYNAMODB_DATA_E2E='true'; require('jest').run(['--runInBand','tests/e2e/dynamoDataPaginacao.e2e.test.ts'])\"",
    "test:watch": "jest --watch --testPathIgnorePatterns=tests/e2e",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=e2e"
  },
  "author": "Giovani Murakami",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1023.0",
    "@aws-sdk/client-s3": "^3.1023.0",
    "@aws-sdk/client-ses": "^3.1023.0",
    "@aws-sdk/client-ssm": "^3.1022.0",
    "@aws-sdk/s3-request-presigner": "^3.1023.0",
    "ably": "^2.20.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "serverless-http": "^3.2.0",
    "uuid": "^10.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "jest": "^30.3.0",
    "mongodb": "^7.5.0",
    "nodemon": "^3.1.7",
    "serverless": "^4.4.6",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "^14.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  }
}
