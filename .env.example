# Copie para o arquivo do ambiente desejado (nunca commitar valores reais):
#   .env.local       — desenvolvimento local (default: APP_ENV=local)
#   .env.homolog     — homologação (stack AWS stage=dev)
#   .env.production  — produção (stack AWS stage=prod)
#
# Uso:
#   npm run dev              # APP_ENV=local
#   npm run dev:homolog      # APP_ENV=homolog
#   npm run deploy:homolog   # stage AWS=dev
#   npm run deploy:prod      # stage AWS=prod

APP_ENV=local
IS_LOCAL=true
PORT=3000
LOG_LEVEL=info

# JWT — RS256 (recomendado). Gere e encode em base64.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# JWT — fallback HS256 só para local sem RSA
JWT_SECRET=sua_chave_secreta_aqui

# Em homolog/production o runtime Lambda usa SSM (serverless injeta pelos stages AWS):
# JWT_SSM_PRIVATE_KEY_PARAM=/championship-mtg/dev/jwt-private-key
# JWT_SSM_PUBLIC_KEY_PARAM=/championship-mtg/dev/jwt-public-key
# JWT_SSM_PRIVATE_KEY_PARAM=/championship-mtg/prod/jwt-private-key
# JWT_SSM_PUBLIC_KEY_PARAM=/championship-mtg/prod/jwt-public-key

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

ABLY_API_KEY=sua_chave_ably_aqui
AWS_S3_BUCKET=fuguete-championship-management
AWS_S3_REGION=us-east-1
AWS_PROFILE=cache-e2e

SES_FROM_EMAIL=Fuguete <noreply@tiagofuguete.com.br>
SES_REGION=us-east-1

# Dynamo — alinhe DATA e CACHE no mesmo ambiente
DYNAMODB_CACHE_ENABLED=true
DYNAMODB_CACHE_REGION=us-east-1
DYNAMODB_DATA_REGION=us-east-1

# local
DYNAMODB_DATA_TABLE=championship-management-mtg-local-data
DYNAMODB_CACHE_TABLE=championship-management-mtg-local-cache

# homolog (AWS stage=dev)
# DYNAMODB_DATA_TABLE=championship-management-mtg-dev-data
# DYNAMODB_CACHE_TABLE=championship-management-mtg-dev-cache

# production (AWS stage=prod)
# DYNAMODB_DATA_TABLE=championship-management-mtg-prod-data
# DYNAMODB_CACHE_TABLE=championship-management-mtg-prod-cache

DYNAMODB_CACHE_TTL_METAGAME_SECONDS=900

ALARM_NOTIFICATION_EMAIL=
SERVERLESS_LICENSE_KEY=
SERVERLESS_ACCESS_KEY=

# Somente migrador Mongo → Dynamo
MONGODB_MIGRATION_URI=
MONGODB_MIGRATION_DB_NAME=test

E2E_KEEP_DATA=false
E2E_STEP_DELAY_MS=0
