
# JWT - Algoritmo RS256 (recomendado para produção)
# Gere as chaves: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Encode em base64: cat private.pem | base64 -w0 > JWT_PRIVATE_KEY_BASE64
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# JWT - Fallback HS256 (apenas para desenvolvimento local quando RS256 não estiver configurado)
JWT_SECRET=sua_chave_secreta_aqui

# Porta local para desenvolvimento
PORT=3000

# CORS - Origem permitida (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Log level (default: info)
LOG_LEVEL=info

# Flag para identificar execução local
IS_LOCAL=true

# Ably - Realtime notifications (use a chave Root)
ABLY_API_KEY=sua_chave_ably_aqui

# AWS S3 - Upload de banners
AWS_S3_BUCKET=seu_bucket_aqui

# DynamoDB cache — deixe DYNAMODB_CACHE_TABLE vazio localmente para desabilitar sem erro.
DYNAMODB_CACHE_ENABLED=true
DYNAMODB_CACHE_TABLE=
DYNAMODB_CACHE_REGION=us-east-1
DYNAMODB_CACHE_TTL_METAGAME_SECONDS=900
DYNAMODB_CACHE_TTL_TORNEIO_SECONDS=60
DYNAMODB_CACHE_TTL_LISTAR_TORNEIOS_SECONDS=30
DYNAMODB_CACHE_TTL_SEO_TORNEIO_SECONDS=1800
DYNAMODB_CACHE_TTL_RANKING_LIGA_SECONDS=300
DYNAMODB_CACHE_TTL_SITE_SECONDS=300

# Tabela DynamoDB usada como banco primario.
DYNAMODB_DATA_TABLE=
DYNAMODB_DATA_REGION=us-east-1

# Email que recebera notificacoes dos alarmes CloudWatch; deixe vazio para criar apenas o topico SNS.
ALARM_NOTIFICATION_EMAIL=

# Email - Remetente para cadastro e reset de senha (conta Gmail)
EMAIL_USER=seu_email@gmail.com

# Email - Senha de app do Gmail (não a senha normal da conta)
# Gere em: Minha Conta → Segurança → Verificação em 2 etapas → Senhas de app
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Frontend URL - Base do app para links em e-mails (reset de senha, etc.). Não afeta CORS.
FRONTEND_URL=https://app.tiagofuguete.com.br

# Origens permitidas no CORS (URL exata do browser). Múltiplas: separadas por vírgula.
CORS_ORIGIN=https://app.tiagofuguete.com.br,https://www.app.tiagofuguete.com.br

