# MongoDB Atlas - Connection string
# Exemplo: mongodb+srv://usuario:senha@cluster.mongodb.net/championship-mtg?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/championship-mtg?retryWrites=true&w=majority

# JWT - Chave secreta para assinar os tokens (use uma string longa e aleatória)
JWT_SECRET=sua_chave_secreta_aqui

# Porta local para desenvolvimento
PORT=3000

# Ably - Realtime notifications (use a chave Root)
ABLY_API_KEY=sua_chave_ably_aqui

#chatgpt CHATGPT_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CHATGPT_API_KEY=sua_chave_chatgpt_aqui